NEXT_PUBLIC_AGENT_MARKET_PACKAGE_ID=0xYOUR_DEPLOYED_PACKAGE_ID
NEXT_PUBLIC_AGORA_AGENT_OPERATOR=0xYOUR_AGORA_AGENT_OPERATOR
NEXT_PUBLIC_AGORA_FIAT_COIN_TYPE=0xUSDC_PACKAGE::usdc::USDC
NEXT_PUBLIC_AGORA_CRYPTO_COIN_TYPE=0x2::sui::SUI

# --- Signal Provider x402 서버 (scripts/x402-server.mjs) ---------------------
# 하나라도 비면 기동 시점에 실패한다. 반쯤 설정된 채로 결제를 받지 않기 위해서다.

# 공용 fullnode의 JSON-RPC가 폐기돼 tx 조회는 GraphQL로 한다.
X402_SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql

# payment_splitter.move가 배포된 Package. 영수증이 이 Package에서 나왔는지 확인한다.
X402_PACKAGE_ID=0x7dcf1c6495682131bcf3a41d4723f7422ca4d49aadaed5d8bc9c2e4a683deb26

# 결제를 내야 하는 Agora 운영 Agent. 남이 낸 결제를 주워 쓰는 것을 막는다.
X402_AGORA_AGENT_ADDRESS=0xYOUR_AGORA_AGENT_ADDRESS

# 이 Provider의 식별자. 영수증의 signal_provider_id와 대조한다.
X402_SIGNAL_PROVIDER_ID=0xYOUR_SIGNAL_PROVIDER_ID

# Provider가 사용료를 받을 주소 (영수증의 payee). Treasury와 다른 주소다.
X402_PAYMENT_RECEIVER=0xYOUR_PROVIDER_PAYOUT_ADDRESS

# Agora 플랫폼 수수료를 받을 Treasury 주소.
X402_TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS

# 결제액 중 Treasury 몫 (bps, 0~10000). 2000 = 20%.
X402_PLATFORM_FEE_BPS=2000

# 결제 코인 타입과 요구 금액 (코인 최소단위).
X402_PAYMENT_TOKEN=0xUSDC_PACKAGE::usdc::USDC
X402_PAYMENT_AMOUNT=1000000

# 서버 바인딩 (선택). 기본값 8402 / /signal
X402_PORT=8402
X402_SIGNAL_PATH=/signal
